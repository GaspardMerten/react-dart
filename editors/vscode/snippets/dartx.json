{
  "Component": {
    "prefix": "comp",
    "body": [
      "Component ${1:Name}({required ${2:String} ${3:label}}) => (",
      "  <${4:div}>",
      "    $0",
      "  </${4:div}>",
      ");"
    ],
    "description": "A component. Its named parameters are its attributes, and the builder generates the props type its markup call sites construct."
  },
  "Stateful component": {
    "prefix": "compstate",
    "body": [
      "Component ${1:Name}() {",
      "  final (${2:value}, set${3:Value}) = useState(${4:0});",
      "",
      "  return <${5:div}>",
      "    $0",
      "  </${5:div}>;",
      "}"
    ],
    "description": "A component with local state"
  },
  "useState": {
    "prefix": "ust",
    "body": "final (${1:value}, set${2:Value}) = useState(${3:initial});",
    "description": "useState hook"
  },
  "useReducer": {
    "prefix": "urd",
    "body": "final (${1:state}, dispatch) = useReducer(${2:reducer}, ${3:initial});",
    "description": "useReducer hook"
  },
  "useEffect": {
    "prefix": "uef",
    "body": [
      "useEffect(() {",
      "  $0",
      "}, const []);"
    ],
    "description": "useEffect hook that runs once"
  },
  "useMemo": {
    "prefix": "umm",
    "body": "final ${1:value} = useMemo(() => $2, [${3:deps}]);",
    "description": "useMemo hook"
  },
  "useRef": {
    "prefix": "urf",
    "body": "final ${1:ref} = useRef(${2:null});",
    "description": "useRef hook"
  },
  "useContext": {
    "prefix": "uctx",
    "body": "final ${1:value} = useContext(${2:context});",
    "description": "useContext hook"
  },
  "Fragment": {
    "prefix": "frag",
    "body": [
      "<>",
      "  $0",
      "</>"
    ],
    "description": "A fragment"
  },
  "Map a list to elements": {
    "prefix": "map",
    "body": "{[for (final ${1:item} in ${2:items}) <${3:li} key={${1:item}.${4:id}}>{${1:item}}</${3:li}>]}",
    "description": "Render a list with keys"
  },
  "Conditional child": {
    "prefix": "if",
    "body": "{${1:condition} ? <${2:div}>$3</${2:div}> : null}",
    "description": "Render a child conditionally"
  },
  "Event handler attribute": {
    "prefix": "onclick",
    "body": "onClick={() => $0}",
    "description": "Click handler"
  },
  "Markup comment": {
    "prefix": "cmt",
    "body": "{/* $0 */}",
    "description": "A comment that is dropped from the output"
  },
  "Memoized component": {
    "prefix": "compmemo",
    "body": [
      "@memoized",
      "Component ${1:Name}({required ${2:Todo} ${3:item}}) => (",
      "  <${4:li}>$0</${4:li}>",
      ");"
    ],
    "description": "A component that skips its re-render when its arguments are unchanged"
  },
  "Component with children": {
    "prefix": "compchildren",
    "body": [
      "Component ${1:Name}({List<VNode> children = const []}) => (",
      "  <${2:section}>{children}</${2:section}>",
      ");"
    ],
    "description": "A component that frames whatever markup it is given"
  },
  "Route": {
    "prefix": "route",
    "body": [
      "Route(",
      "  path: '${1:todo/:id}',",
      "  element: const ${2:TodoPage}Props(),",
      "  loader: (context) => ${3:fetchTodo}(context.params['${4:id}']!),",
      "),"
    ],
    "description": "A route with a loader"
  }
}
