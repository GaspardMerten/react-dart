{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "/*", "close": " */", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["'", "'"],
    ["\"", "\""],
    ["<", ">"]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$|^\\s*<[^/>]*(?<!/)>\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|\\]|</[^>]+>)"
  },
  "onEnterRules": [
    {
      "beforeText": "<([_$a-zA-Z][-\\w$.:]*)(?:\\s[^<>]*)?(?<!/)>\\s*$",
      "afterText": "^\\s*</",
      "action": { "indent": "indentOutdent" }
    },
    {
      "beforeText": "<([_$a-zA-Z][-\\w$.:]*)(?:\\s[^<>]*)?(?<!/)>\\s*$",
      "action": { "indent": "indent" }
    },
    {
      "beforeText": "^\\s*///.*$",
      "action": { "indent": "none", "appendText": "/// " }
    }
  ]
}
