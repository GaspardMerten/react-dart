/// The shared component tree for the example app, written in dartx.
///
/// The exact same code renders on the server (`server.dart` -> HTML) and on the
/// client (`main.dart` -> hydrated, interactive DOM). That is the whole pitch:
/// write components once, get SSR + a live client, all in pure Dart.
///
/// This is a `.dartx` file: ordinary Dart, plus markup wherever an expression
/// is allowed. `dart run build_runner build` compiles it to `app.dartx.dart`.
library;

import 'package:reactx/events.dart';
import 'package:reactx/reactx.dart';

/// Root component.
Component App() => <div class="app">
      <h1>reactx demo</h1>
      <p>React, reimplemented in Dart — server-rendered, then hydrated.</p>
      <Counter />
      <Todos />
    </div>;

/// A classic counter.
Component Counter() {
  final (count, setCount) = useState(0);

  return <section class="counter">
    <h2>Counter</h2>
    <p>Value: <strong>{count}</strong></p>
    <button onClick={() => setCount((c) => c - 1)}>-</button>
    <button onClick={() => setCount((c) => c + 1)}>+</button>
  </section>;
}

/// A controlled-input todo list. Shows keyed list reconciliation.
Component Todos() {
  final (items, setItems) = useState<List<String>>(const ['Learn reactx']);
  final (draft, setDraft) = useState('');

  void add() {
    if (draft.trim().isEmpty) return;
    setItems([...items, draft.trim()]);
    setDraft('');
  }

  return <section class="todos">
    <h2>Todos ({items.length})</h2>
    <ul>
      {[for (final (i, item) in items.indexed) <li key={i}>{item}</li>]}
    </ul>
    <input value={draft} onInput={onValue(setDraft)} placeholder="Add a todo" />
    <button onClick={add}>Add</button>
  </section>;
}
